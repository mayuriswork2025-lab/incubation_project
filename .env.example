# Direct Postgres connection string, used by Drizzle for typed queries/migrations.
# Local dev default when running `supabase start`: postgresql://postgres:postgres@127.0.0.1:54322/postgres
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Backend server
PORT=3001
FRONTEND_URL=http://localhost:5173

VITE_API_URL=http://localhost:3001
